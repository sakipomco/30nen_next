# 環境変数の見本（このファイルはGit管理。実際の値は .env.local に書く）
# 使い方: このファイルを .env.local にコピーし、各値を埋める。

# セッション（JWT会員証）の署名に使う秘密鍵。長いランダム文字列。
# 生成例（ターミナルで実行）: openssl rand -base64 32
SESSION_SECRET=

# DBファイルの場所（未設定なら既定の data/30nen.db を使う）
# DATABASE_PATH=data/30nen.db

# ── サイトの公開URL／検索エンジン対応（SEO）──
# サイトの公開URL（末尾スラッシュなし）。sitemap.xml・OGP・canonical で絶対URLに使う。
# 未設定なら本番ドメイン https://30nen.com を既定とする。お試し/別URLのときはその値を入れる。
# SITE_URL=https://30nen.com
#
# 検索エンジンにインデックス（登録）させてよいか。
# ★安全のため既定は「させない」。練習用/お試しサイトを誤ってGoogleに載せないため。
# 本番に切り替えたサーバーだけ SITE_INDEXABLE=true を設定する（robots許可＋index有効になる）。
# SITE_INDEXABLE=true

# ログイン会員証(Cookie)を「HTTPSのときだけ送る」か。
# 未設定なら本番(production)で自動的に true（＝HTTPS必須・安全）。
# HTTPS未設定のサーバーで http のままお試しするときだけ false にする
# （false にしないと http ではログインが続かない）。HTTPSを整えたら外す。
# SESSION_COOKIE_SECURE=false

# ── 招待メール・パスワードリセットメール（Resend）──────────
# Resend（resend.com）の無料アカウントを作り、APIキーを取得して設定する。
# 月3,000通・1日100通まで無料。20人の書き手なら十分。
# 送信元ドメイン（30nen.com）を Resend に登録（DNS設定）する必要がある。
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=三十年商店 <noreply@30nen.com>

# ── バックアップ失敗の知らせ（サーバーのみ）────────────
# バックアップ（cronの毎日4:00／日曜4:30）が失敗したとき、この宛先にメールで知らせる。
# 送信には上の RESEND_API_KEY を使う（招待メールと同じ仕組み）。
# 未設定だと知らせを送れず、ログに1行残るだけになる。
# 動作確認: npx tsx scripts/backup/notify-backup-failure.ts --test
# BACKUP_ALERT_TO=you@example.com

# ── お便りフォームのメール送信（本番化のときに設定）──
# Xサーバーのメールアカウント（例 info@30nen.com）を使う。未設定のローカルでは
# 実際には送らず、内容をサーバーのコンソールに出すだけ（画面の流れは確認できる）。
# SMTP_HOST=sv****.xserver.jp
# SMTP_PORT=465
# SMTP_SECURE=true          # 465=true（SSL） / 587=false（STARTTLS）
# SMTP_USER=info@30nen.com
# SMTP_PASS=
# MAIL_FROM=三十年商店 <info@30nen.com>   # 送信元の表示（未設定なら SMTP_USER）
# CONTACT_TO_EMAIL=info@30nen.com         # 「店主」宛のお便りの届け先
