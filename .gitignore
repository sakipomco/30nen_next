# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただし「見本」(.env.example) は秘密情報なしなのでGit管理する
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# アップロードされた画像（投稿者が上げたファイル。中身が育つのでGit管理しない。フォルダだけ .gitkeep で保持）
/public/uploads/*
!/public/uploads/.gitkeep

# database (SQLite本体は中身が育つファイルなので管理対象外。設計図とマイグレーションはGit管理する)
/data/*.db
/data/*.db-shm
/data/*.db-wal

# ローカル専用ツール設定（プレビュー起動設定など。絶対パスを含むため各自の環境固有）
/.claude/
